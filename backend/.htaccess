# RoboNexus backend — block direct access to secrets and data files.
# PHP endpoints keep working; only raw files are denied.

# Never expose the environment file
<FilesMatch "^\.env">
  Require all denied
</FilesMatch>

# Never allow the JSON data stores (users.json holds password hashes) to be
# downloaded. .sql is included so a stray schema dump can't be fetched either.
<FilesMatch "\.(json|log|sql|md)$">
  Require all denied
</FilesMatch>
